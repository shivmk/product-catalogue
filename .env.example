# Copy to .env to override defaults. Every value is optional; the defaults work out of the box.
# Never commit .env.

# --- Product data ---
FAKE_STORE_BASE_URL=https://fakestoreapi.com
# Seconds to cache the catalogue from the product source.
PRODUCT_CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=5000

# --- Merchandising ---
# The products chosen as "top rated" on the home page, in display order.
FEATURED_PRODUCT_IDS=1,5,9,13,18
# How many products appear in the "Top rated" section of each category page.
CATEGORY_TOP_RATED_COUNT=3

# --- Email ---
# smtp | console. "console" logs emails instead of sending them (local `npm run dev` only).
# docker compose always uses smtp with the bundled Mailpit inbox.
MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SALES_INBOX=sales@example.com
MAIL_FROM=Product Catalogue <no-reply@example.com>
# Used for the product link in the sales email.
PUBLIC_WEB_URL=http://localhost:8080

# --- API ---
PORT=3000
LOG_LEVEL=info
# Only needed if the web app is served from a different origin than the API.
CORS_ORIGINS=
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
